    }
    .article-content h3 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.2rem;
      color: var(--primary-dark);
      margin: 20px 0 8px 0;
    }
    .article-content p {
      margin-bottom: 15px;
      text-indent: 20px;
    }
    
    blockquote {
      font-style: italic;
      background: #f8fafc;
      border-left: 4px solid var(--accent-color);
      margin: 20px 0;
      padding: 12px 20px;
      color: #475569;
