    /* Page Footer */
    .page-footer {
      border-top: 1px solid #f1f5f9;
      padding-top: 15px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.8rem;
      color: #94a3b8;
      display: flex;
      justify-content: space-between;
      margin-top: auto;
