    /* A4 Print Stylesheet */
    @media print {
      body {
        background-color: #ffffff;
      }
      .magazine-wrapper {
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .magazine-header {
        display: none; /* Hide header banner when printing to start directly with pages */
      }
      .a4-page {
        width: 210mm;
        height: 297mm;
        padding: 20mm;
        margin: 0;
        box-shadow: none;
        border-radius: 0;
        page-break-after: always; /* Forces exact 1 page per article when exported to PDF */
      }
    }
