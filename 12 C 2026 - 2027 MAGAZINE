  <style>
    :root {
      --primary-dark: #0f172a;
      --accent-color: #1e3a8a;
      --text-color: #1e293b;
      --bg-color: #f1f5f9;
      --paper-bg: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Lora', serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      line-height: 1.7;
    }

    /* Web Preview Styling */
    .magazine-wrapper {
      max-width: 900px;
      margin: 40px auto;
      padding: 0 15px;
    }

    /* Cover / Main Header */
    .magazine-header {
      text-align: center;
      background: var(--primary-dark);
      color: #fff;
      padding: 50px 20px;
      border-radius: 12px;
      margin-bottom: 40px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }
    .magazine-header h1 {
      font-family: 'Cinzel', serif;
      font-size: 2.8rem;
      letter-spacing: 2px;
      margin-bottom: 10px;
      color: #f8fafc;
    }
    .magazine-header p {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.1rem;
      color: #94a3b8;
    }

    /* A4 Page Formatting */
    .a4-page {
      background: var(--paper-bg);
      width: 100%;
      min-height: 1120px; /* Represents standard digital view height for A4 scale */
      padding: 50px 55px;
      margin-bottom: 40px;
      border-radius: 8px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.06);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Article Typography & Elements */
    .article-header {
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 15px;
      margin-bottom: 25px;
    }
    .category-tag {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--accent-color);
      letter-spacing: 1.5px;
      display: block;
      margin-bottom: 5px;
    }
    .article-title {
      font-family: 'Cinzel', serif;
      font-size: 2.1rem;
      color: var(--primary-dark);
      line-height: 1.25;
      margin-bottom: 10px;
    }
    .author-bar {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.9rem;
      color: #64748b;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .hero-image {
      width: 100%;
